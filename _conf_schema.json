{
    "gcp_basic": {
        "description": "⚙️ 基础",
        "type": "object",
        "items": {
            "enable_group_chat": {
                "description": "启用群聊增强",
                "type": "bool",
                "default": true,
                "hint": "关闭后本插件不处理任何群聊消息。"
            },
            "enable_private_chat": {
                "description": "启用私聊增强",
                "type": "bool",
                "default": false,
                "hint": "开启后处理私聊；关闭时保持原有群聊-only 行为。"
            },
            "enabled_private_users": {
                "description": "启用的私聊用户",
                "type": "list",
                "default": [],
                "hint": "留空=所有私聊用户；填用户ID则只处理指定用户。"
            },
            "takeover_private_reply": {
                "description": "接管私聊回复",
                "type": "bool",
                "default": true,
                "hint": "开启=插件决定不回复时阻止 AstrBot 默认兜底回复。"
            },
            "private_reply_mode": {
                "description": "私聊回复策略",
                "type": "string",
                "options": [
                    "direct",
                    "decide"
                ],
                "default": "direct",
                "hint": "direct=普通私聊直接回应，不受群聊安静人格规则影响；decide=使用私聊专用读空气。纯图片/表情包仍按各自媒体策略处理。"
            },
            "enable_debug_log": {
                "description": "调试日志",
                "type": "bool",
                "default": false,
                "hint": "开启后输出更多处理细节日志，排查用。"
            },
            "enabled_groups": {
                "description": "启用的群聊",
                "type": "list",
                "default": [],
                "hint": "留空=全部群；填群号则只在指定群生效，每行一个。"
            },
            "desktop_mode": {
                "description": "运行环境识别",
                "type": "string",
                "default": "auto",
                "options": [
                    "auto",
                    "force_desktop",
                    "force_standard"
                ],
                "hint": "auto 自动识别桌面端/服务端。"
            },
            "takeover_group_reply": {
                "description": "接管群聊回复",
                "type": "bool",
                "default": true,
                "hint": "开启=由本插件的读空气全权决定是否回复，挡住 AstrBot 主对话（避免 @/点名被兜底必回）；关闭=交给 AstrBot 默认行为。"
            }
        }
    },
    "gcp_decision": {
        "description": "🧠 读空气（决定要不要回）",
        "type": "object",
        "items": {
            "decision_ai_provider_id": {
                "description": "判断用模型",
                "type": "string",
                "default": "",
                "hint": "留空=跟随会话默认模型。",
                "_special": "select_provider"
            },
            "decision_ai_include_persona": {
                "description": "判断携带人格",
                "type": "bool",
                "default": true,
                "hint": "开启=读空气判断用你的人格当主角(推荐)。只影响判断，不影响回复内容。"
            },
            "decision_ai_extra_prompt": {
                "description": "判断补充提示词",
                "type": "text",
                "default": "",
                "hint": "给判断AI追加要求；留空用默认。",
                "promptDataRef": "decision-ai"
            },
            "decision_ai_timeout": {
                "description": "判断超时(秒)",
                "type": "int",
                "default": 30,
                "hint": "判断超时则不回复；建议30。"
            },
            "decision_ai_reply_tendency": {
                "description": "回复倾向",
                "type": "string",
                "options": [
                    "persona",
                    "reserved",
                    "active"
                ],
                "default": "persona",
                "hint": "persona=按人格性格；reserved=保守；active=积极。"
            },
            "decision_ai_persona_name": {
                "description": "指定判断人格",
                "type": "string",
                "default": "",
                "hint": "留空=跟随当前会话人格；填人格名固定用它判断。"
            }
        }
    },
    "gcp_trigger": {
        "description": "🗝️ 触发关键词",
        "type": "object",
        "items": {
            "trigger_keywords": {
                "description": "触发关键词",
                "type": "list",
                "default": [],
                "hint": "命中即跳过随机、必参与判断(可填角色别名)。"
            },
            "blacklist_keywords": {
                "description": "屏蔽关键词",
                "type": "list",
                "default": [],
                "hint": "命中直接忽略该消息。"
            },
            "keyword_smart_mode": {
                "description": "关键词智能模式",
                "type": "bool",
                "default": true,
                "hint": "开启=命中关键词（如bot名字/被@）也交给读空气AI按人格判断是否回复（推荐）；关闭=命中关键词则必回（仅对关键词命中生效，@仍按判断）。"
            }
        }
    },
    "gcp_reply": {
        "description": "💬 回复生成与防复读",
        "type": "object",
        "items": {
            "reply_ai_extra_prompt": {
                "description": "回复补充提示词",
                "type": "text",
                "default": "",
                "hint": "生成回复时追加的要求；留空用默认。",
                "promptDataRef": "reply-ai"
            },
            "include_timestamp": {
                "description": "带发送时间",
                "type": "bool",
                "default": true,
                "hint": "消息上下文标注发送时间。"
            },
            "include_sender_info": {
                "description": "带发送者信息",
                "type": "bool",
                "default": true,
                "hint": "消息上下文标注发送者。"
            },
            "collapse_reply_newlines": {
                "description": "收敛普通回复换行",
                "type": "bool",
                "default": false,
                "hint": "开启后将普通纯文本回复中的主动换行合并为空格；代码块和 Markdown 列表保留原格式。"
            },
            "max_context_messages": {
                "description": "历史消息条数",
                "type": "int",
                "default": -1,
                "hint": "喂给AI的历史上限；-1不限，0不获取。"
            },
            "enable_duplicate_filter": {
                "description": "防复读",
                "type": "bool",
                "default": true,
                "hint": "避免重复表达相同观点。"
            }
        }
    },
    "gcp_manage": {
        "description": "🚫 群聊管理与过滤",
        "type": "object",
        "items": {
            "enable_user_blacklist": {
                "description": "用户黑名单开关",
                "type": "bool",
                "default": false,
                "hint": "屏蔽指定用户的消息。"
            },
            "blacklist_user_ids": {
                "description": "黑名单用户ID",
                "type": "list",
                "default": [],
                "hint": "每行一个QQ号，其消息被忽略。"
            },
            "enable_command_filter": {
                "description": "指令过滤开关",
                "type": "bool",
                "default": true,
                "hint": "忽略以指定前缀开头(如/、!)的消息。"
            },
            "command_prefixes": {
                "description": "指令前缀",
                "type": "list",
                "default": [
                    "/",
                    "!",
                    "#"
                ],
                "hint": "以这些前缀开头的消息不处理，如 / ! #。"
            }
        }
    },
    "gcp_concurrent": {
        "description": "⚡ 并发（Smart 批量）",
        "type": "object",
        "items": {
            "concurrent_mode": {
                "description": "并发模式",
                "type": "string",
                "default": "legacy",
                "options": [
                    "legacy",
                    "smart"
                ],
                "hint": "legacy=逐条独立；smart=短时多条合并一批再判断回复。"
            },
            "private_concurrent_mode": {
                "description": "私聊并发模式",
                "type": "string",
                "default": "smart",
                "options": [
                    "legacy",
                    "smart"
                ],
                "hint": "私聊单独控制；smart 会把短时间连续私聊合并为一轮输入后只生成一条回复。"
            },
            "private_batch_wait_ms": {
                "description": "私聊短连发等待(毫秒)",
                "type": "int",
                "default": 4500,
                "hint": "Smart 首条消息等待后续短连发的时间；默认 4500，窗口越大越容易合并，但单条消息也会等待更久。"
            },
            "private_batch_max_size": {
                "description": "私聊批次上限",
                "type": "int",
                "default": 10,
                "hint": "单个私聊批次最多合并的消息数。"
            }
        }
    },
    "gcp_enhance": {
        "description": "✨ 扩展（图片/记忆/表情/戳一戳）",
        "type": "object",
        "items": {
            "enable_image_processing": {
                "description": "图片识别",
                "type": "bool",
                "default": false,
                "hint": "把图片转成文字描述喂给AI。"
            },
            "image_to_text_scope": {
                "description": "图片处理范围",
                "type": "string",
                "default": "all",
                "options": [
                    "all",
                    "mention_only",
                    "at_only",
                    "keyword_only"
                ],
                "hint": "all=所有图片；mention_only=@或关键词才处理（其余纯图片整条丢弃）；at_only=仅@消息；keyword_only=仅关键词消息。"
            },
            "private_image_mode": {
                "description": "私聊纯图片策略",
                "type": "string",
                "default": "decide",
                "options": [
                    "ignore",
                    "decide",
                    "always"
                ],
                "hint": "ignore=忽略纯图片；decide=交给读空气；always=直接处理。含文字的图文消息仍按普通消息处理。"
            },
            "private_emoji_mode": {
                "description": "私聊纯表情包策略",
                "type": "string",
                "default": "ignore",
                "options": [
                    "ignore",
                    "decide",
                    "always"
                ],
                "hint": "ignore=忽略水消息；decide=让读空气判断是否回应；always=直接处理。"
            },
            "private_collapse_duplicate_emoji": {
                "description": "折叠重复表情包",
                "type": "bool",
                "default": true,
                "hint": "同一批次或短时间内重复发送相同表情包时只保留一份。"
            },
            "private_duplicate_emoji_window_ms": {
                "description": "重复表情窗口(毫秒)",
                "type": "int",
                "default": 1500,
                "hint": "同一表情包在窗口内重复发送时直接折叠。"
            },
            "image_to_text_provider_id": {
                "description": "图片转文字模型",
                "type": "string",
                "default": "",
                "hint": "留空=直接把图片给多模态回复AI。",
                "_special": "select_provider"
            },
            "enable_memory_injection": {
                "description": "记忆注入",
                "type": "bool",
                "default": false,
                "hint": "从记忆插件(livingmemory)取记忆辅助判断/回复。"
            },
            "memory_plugin_mode": {
                "description": "记忆插件",
                "type": "string",
                "default": "auto",
                "options": [
                    "auto",
                    "legacy",
                    "livingmemory"
                ],
                "hint": "auto=自动检测已安装记忆插件。"
            },
            "livingmemory_top_k": {
                "description": "记忆条数",
                "type": "int",
                "default": 5,
                "hint": "每次召回记忆条数。"
            },
            "enable_emoji_filter": {
                "description": "表情包识别",
                "type": "bool",
                "default": false,
                "hint": "识别表情包并按规则降低触发概率(QQ平台)。"
            },
            "poke_message_mode": {
                "description": "戳一戳模式",
                "type": "string",
                "default": "bot_only",
                "options": [
                    "ignore",
                    "bot_only",
                    "all"
                ],
                "hint": "ignore=忽略；bot_only=仅响应戳自己；all=都处理。"
            },
            "enable_poke_after_reply": {
                "description": "回复后戳一戳",
                "type": "bool",
                "default": false,
                "hint": "回复后按概率戳一下提问者。"
            },
            "poke_after_reply_probability": {
                "description": "回复后戳人概率",
                "type": "float",
                "default": 0.15,
                "hint": "回复后戳一戳的概率(建议0.1-0.3)。"
            },
            "max_images_per_message": {
                "description": "单条图片上限",
                "type": "int",
                "default": 10,
                "hint": "单条消息最多处理几张图。"
            }
        }
    }
}