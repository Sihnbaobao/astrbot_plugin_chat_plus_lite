{
    "gcp_basic": {
        "description": "⚙️ 基础",
        "type": "object",
        "items": {
            "enable_group_chat": {
                "description": "启用群聊增强",
                "type": "bool",
                "default": true,
                "hint": "关闭后本插件不处理任何群聊消息。"
            },
            "enable_debug_log": {
                "description": "调试日志",
                "type": "bool",
                "default": false,
                "hint": "开启后输出更多处理细节日志，排查用。"
            },
            "enabled_groups": {
                "description": "启用的群聊",
                "type": "list",
                "default": [],
                "hint": "留空=全部群；填群号则只在指定群生效，每行一个。"
            },
            "desktop_mode": {
                "description": "运行环境识别",
                "type": "string",
                "default": "auto",
                "options": [
                    "auto",
                    "force_desktop",
                    "force_standard"
                ],
                "hint": "auto 自动识别桌面端/服务端。"
            }
        }
    },
    "gcp_decision": {
        "description": "🧠 读空气（决定要不要回）",
        "type": "object",
        "items": {
            "enable_random_probability_filter": {
                "description": "随机概率筛选",
                "type": "bool",
                "default": false,
                "hint": "关闭=AI全权判断要不要回；开启=先按概率抽签。建议保持关闭。"
            },
            "initial_probability": {
                "description": "初始概率",
                "type": "float",
                "default": 0.02,
                "hint": "开启随机筛选时的基础回复概率(0-1)。"
            },
            "decision_ai_provider_id": {
                "description": "判断用模型",
                "type": "string",
                "default": "",
                "hint": "留空=跟随会话默认模型。",
                "_special": "select_provider"
            },
            "decision_ai_include_persona": {
                "description": "判断携带人格",
                "type": "bool",
                "default": true,
                "hint": "开启=读空气判断用你的人格当主角(推荐)。只影响判断，不影响回复内容。"
            },
            "decision_ai_extra_prompt": {
                "description": "判断补充提示词",
                "type": "text",
                "default": "",
                "hint": "给判断AI追加要求；留空用默认。",
                "promptDataRef": "decision-ai"
            },
            "decision_ai_timeout": {
                "description": "判断超时(秒)",
                "type": "int",
                "default": 30,
                "hint": "判断超时则不回复；建议30。"
            },
            "decision_ai_reply_tendency": {
                "description": "回复倾向",
                "type": "string",
                "options": [
                    "persona",
                    "reserved",
                    "active"
                ],
                "default": "persona",
                "hint": "persona=按人格性格；reserved=保守；active=积极。"
            },
            "decision_ai_persona_name": {
                "description": "指定判断人格",
                "type": "string",
                "default": "",
                "hint": "留空=跟随当前会话人格；填人格名固定用它判断。"
            }
        }
    },
    "gcp_trigger": {
        "description": "🗝️ 触发关键词",
        "type": "object",
        "items": {
            "trigger_keywords": {
                "description": "触发关键词",
                "type": "list",
                "default": [],
                "hint": "命中即跳过随机、必参与判断(可填角色别名)。"
            },
            "blacklist_keywords": {
                "description": "屏蔽关键词",
                "type": "list",
                "default": [],
                "hint": "命中直接忽略该消息。"
            },
            "keyword_smart_mode": {
                "description": "关键词智能模式",
                "type": "bool",
                "default": false,
                "hint": "开启=命中关键词仍交给读空气判断，而非必回。"
            }
        }
    },
    "gcp_reply": {
        "description": "💬 回复生成与防复读",
        "type": "object",
        "items": {
            "reply_ai_extra_prompt": {
                "description": "回复补充提示词",
                "type": "text",
                "default": "",
                "hint": "生成回复时追加的要求；留空用默认。",
                "promptDataRef": "reply-ai"
            },
            "include_timestamp": {
                "description": "带发送时间",
                "type": "bool",
                "default": true,
                "hint": "消息上下文标注发送时间。"
            },
            "include_sender_info": {
                "description": "带发送者信息",
                "type": "bool",
                "default": true,
                "hint": "消息上下文标注发送者。"
            },
            "max_context_messages": {
                "description": "历史消息条数",
                "type": "int",
                "default": -1,
                "hint": "喂给AI的历史上限；-1不限，0不获取。"
            },
            "after_reply_probability": {
                "description": "回复后概率提升",
                "type": "float",
                "default": 0.8,
                "hint": "回复后临时提升随机概率促连续对话(随机模式)。"
            },
            "probability_duration": {
                "description": "概率提升时长(秒)",
                "type": "int",
                "default": 120,
                "hint": "回复后概率提升持续多久。"
            },
            "enable_duplicate_filter": {
                "description": "防复读",
                "type": "bool",
                "default": true,
                "hint": "避免重复表达相同观点。"
            },
            "duplicate_filter_check_count": {
                "description": "防复读检查条数",
                "type": "int",
                "default": 5,
                "hint": "对照最近几条回复查重。"
            },
            "duplicate_filter_time_limit": {
                "description": "防复读时效(秒)",
                "type": "int",
                "default": 1800,
                "hint": "仅在该时间内查重。"
            },
            "custom_storage_max_messages": {
                "description": "上下文缓存上限(条)",
                "type": "int",
                "default": 500,
                "hint": "本地上下文缓存最多保留的消息数。"
            },
            "enable_duplicate_time_limit": {
                "description": "防复读·时效开关",
                "type": "bool",
                "default": true,
                "hint": "开启后防复读仅考虑时效内消息。"
            },
            "reply_timeout_warning_threshold": {
                "description": "回复超时告警(秒)",
                "type": "int",
                "default": 120,
                "hint": "回复超过该时长打警告。"
            },
            "reply_generation_timeout_warning": {
                "description": "生成超时告警(秒)",
                "type": "int",
                "default": 60,
                "hint": "单次生成超该时长打警告。"
            }
        }
    },
    "gcp_manage": {
        "description": "🚫 群聊管理与过滤",
        "type": "object",
        "items": {
            "enable_user_blacklist": {
                "description": "用户黑名单开关",
                "type": "bool",
                "default": false,
                "hint": "屏蔽指定用户的消息。"
            },
            "blacklist_user_ids": {
                "description": "黑名单用户ID",
                "type": "list",
                "default": [],
                "hint": "每行一个QQ号，其消息被忽略。"
            },
            "enable_command_filter": {
                "description": "指令过滤开关",
                "type": "bool",
                "default": true,
                "hint": "忽略以指定前缀开头(如/、!)的消息。"
            },
            "command_prefixes": {
                "description": "指令前缀",
                "type": "list",
                "default": [
                    "/",
                    "!",
                    "#"
                ],
                "hint": "以这些前缀开头的消息不处理，如 / ! #。"
            }
        }
    },
    "gcp_concurrent": {
        "description": "⚡ 并发（Smart 批量）",
        "type": "object",
        "items": {
            "concurrent_mode": {
                "description": "并发模式",
                "type": "string",
                "default": "legacy",
                "options": [
                    "legacy",
                    "smart"
                ],
                "hint": "legacy=逐条独立；smart=短时多条合并一批再判断回复。"
            }
        }
    },
    "gcp_enhance": {
        "description": "✨ 扩展（图片/记忆/表情/戳一戳）",
        "type": "object",
        "items": {
            "enable_image_processing": {
                "description": "图片识别",
                "type": "bool",
                "default": false,
                "hint": "把图片转成文字描述喂给AI。"
            },
            "image_to_text_provider_id": {
                "description": "图片转文字模型",
                "type": "string",
                "default": "",
                "hint": "留空=直接把图片给多模态回复AI。",
                "_special": "select_provider"
            },
            "image_to_text_prompt": {
                "description": "图片描述提示词",
                "type": "text",
                "default": "请详细描述这张图片的内容",
                "hint": "让模型描述图片时的要求。"
            },
            "image_to_text_timeout": {
                "description": "图片转文字超时(秒)",
                "type": "int",
                "default": 60,
                "hint": "超时放弃转换。"
            },
            "enable_memory_injection": {
                "description": "记忆注入",
                "type": "bool",
                "default": false,
                "hint": "从记忆插件(livingmemory)取记忆辅助判断/回复。"
            },
            "memory_plugin_mode": {
                "description": "记忆插件",
                "type": "string",
                "default": "auto",
                "options": [
                    "auto",
                    "legacy",
                    "livingmemory"
                ],
                "hint": "auto=自动检测已安装记忆插件。"
            },
            "memory_insertion_timing": {
                "description": "记忆注入阶段",
                "type": "string",
                "default": "post_decision",
                "options": [
                    "pre_decision",
                    "post_decision"
                ],
                "hint": "pre_decision=判断前注入，帮助决定回不回。"
            },
            "livingmemory_top_k": {
                "description": "记忆条数",
                "type": "int",
                "default": 5,
                "hint": "每次召回记忆条数。"
            },
            "enable_emoji_filter": {
                "description": "表情包识别",
                "type": "bool",
                "default": false,
                "hint": "识别表情包并按规则降低触发概率(QQ平台)。"
            },
            "emoji_probability_decay": {
                "description": "表情包概率衰减",
                "type": "float",
                "default": 0.7,
                "hint": "遇表情包时的概率衰减系数。"
            },
            "emoji_decay_min_probability": {
                "description": "衰减下限",
                "type": "float",
                "default": 0.1,
                "hint": "概率低于此值不再衰减。"
            },
            "poke_message_mode": {
                "description": "戳一戳模式",
                "type": "string",
                "default": "bot_only",
                "options": [
                    "ignore",
                    "bot_only",
                    "all"
                ],
                "hint": "ignore=忽略；bot_only=仅响应戳自己；all=都处理。"
            },
            "poke_bot_skip_probability": {
                "description": "被戳跳过概率",
                "type": "bool",
                "default": true,
                "hint": "戳自己时跳过随机概率直接处理。"
            },
            "enable_poke_after_reply": {
                "description": "回复后戳一戳",
                "type": "bool",
                "default": false,
                "hint": "回复后按概率戳一下提问者。"
            },
            "poke_after_reply_probability": {
                "description": "回复后戳人概率",
                "type": "float",
                "default": 0.15,
                "hint": "回复后戳一戳的概率(建议0.1-0.3)。"
            },
            "poke_enabled_groups": {
                "description": "启用的群(戳一戳)",
                "type": "list",
                "default": [],
                "hint": "留空=全部群；填群号限定。"
            },
            "max_images_per_message": {
                "description": "单条图片上限",
                "type": "int",
                "default": 10,
                "hint": "单条消息最多处理几张图。"
            }
        }
    }
}